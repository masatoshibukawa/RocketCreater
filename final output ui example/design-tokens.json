{
  "version": 1,
  "status": "design proposal; not wired into the application",
  "units": "CSS px unless stated",
  "theme": "dark",
  "color": {
    "canvas": "#17191c",
    "surface": "#202226",
    "raised": "#282c32",
    "text": "#f2f4f7",
    "muted": "#b3bac5",
    "separator": "#3b414b",
    "controlBorder": "#737e90",
    "primary": "#2563eb",
    "onPrimary": "#ffffff",
    "focus": "#9cc4ff",
    "selection": "#263d5e",
    "onSelection": "#e4efff",
    "pendingSurface": "#352a16",
    "pendingText": "#f4c66e",
    "errorSurface": "#382325",
    "errorText": "#ff9b9b",
    "successSurface": "#20382c",
