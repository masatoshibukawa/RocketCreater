      "size": 16,
      "lineHeight": 24,
      "weight": 600
    },
    "body": {
      "size": 14,
      "lineHeight": 22,
      "weight": 400
    },
    "control": {
      "size": 14,
      "lineHeight": 20,
      "weight": 500
    },
    "metadata": {
      "size": 12,
      "lineHeight": 18,
      "weight": 400
    },
    "metric": {
      "size": 24,
      "lineHeight": 32,
      "weight": 500
    },
