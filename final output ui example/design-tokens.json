  },
  "contrastPairs": [
    {
      "id": "body-on-surface",
      "foreground": "text",
      "background": "surface",
      "target": 4.5
    },
    {
      "id": "muted-on-surface",
      "foreground": "muted",
      "background": "surface",
      "target": 4.5
    },
    {
      "id": "primary-label",
      "foreground": "onPrimary",
      "background": "primary",
      "target": 4.5
    },
    {
      "id": "selected-label",
      "foreground": "onSelection",
      "background": "selection",
      "target": 4.5
    },
    {
      "id": "pending-label",
      "foreground": "pendingText",
      "background": "pendingSurface",
      "target": 4.5
    },
    {
      "id": "error-label",
      "foreground": "errorText",
      "background": "errorSurface",
      "target": 4.5
    },
    {
      "id": "success-label",
      "foreground": "successText",
      "background": "successSurface",
      "target": 4.5
    },
    {
      "id": "control-boundary",
      "foreground": "controlBorder",
      "background": "surface",
      "target": 3
    },
    {
      "id": "focus-on-surface",
      "foreground": "focus",
      "background": "surface",
      "target": 3
    }
  ],
  "contrastScope": "Project targets for flat, opaque token pairs only. Decorative separators are not control boundaries. Generated images, charts, transparency, hover states and whole-page accessibility require separate verification."
