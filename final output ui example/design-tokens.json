  },
  "layout": {
    "identityBar": 48,
    "phaseBar": 44,
    "statusBarMin": 56,
    "globalRail": 48,
    "desktopMinWidth": 1440,
    "leftDock": 224,
    "rightDock": 344,
    "compactDesktopMinWidth": 1200,
    "compactLeftDock": 200,
    "compactRightDock": 320,
    "tabletMinWidth": 768,
    "tabletLeftDock": "drawer",
    "phone": "single column; panels below figure",
    "drawerWidth": 400,
    "contentGap": 16,
    "bodyMaxCharactersJa": 32
  },
  "controls": {
    "desktopMinHeight": 36,
    "touchMinHeight": 44,
    "inputMinHeight": 40,
    "fieldLabelAlwaysVisible": true,
    "primaryActionPerDecisionArea": 1,
    "dialogMaxWidth": 520
  },
