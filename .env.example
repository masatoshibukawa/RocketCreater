# Not loaded automatically: export these in the shell that starts the API, or copy this file
# to .env (never committed) and run `set -a; . ./.env; set +a` first.
ANTHROPIC_API_KEY=

# Paid design is off by default. Set to 1 to let POST /design call Claude (costs money).
ROCKETWRIGHT_ENABLE_CLOUD_DESIGN=0
# Local-only structured direction. No model is downloaded by the application.
ROCKETWRIGHT_OLLAMA_URL=http://127.0.0.1:11434
ROCKETWRIGHT_LOCAL_MODEL=
ROCKETWRIGHT_COMFY_URL=http://127.0.0.1:8188
# Optional: existing AIvideo directory when running in a separate worktree.
# ROCKETWRIGHT_MEDIA_ROOT=C:/path/to/AIvideo
